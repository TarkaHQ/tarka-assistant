# ---- Core ------------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
# Public https URL of this deployment (webhooks, sign-in links, OAuth redirects)
PUBLIC_URL=https://assistant.example.com
DATABASE_URL=postgres://assistant:password@db:5432/assistant
# 32+ random bytes; encrypts OAuth tokens and signs links. Generate: openssl rand -base64 48
APP_SECRET=

# ---- Models (Tarka) ----------------------------------------------------------------------------
# Inside a Tarka agent host these come from the platform (OPENAI_BASE_URL=http://tarka/v1).
# Outside one, use https://tarka.rest/v1 and a tk_live_ key from the Tarka console.
TARKA_BASE_URL=https://tarka.rest/v1
TARKA_API_KEY=
DEFAULT_MODEL=qwen3.8-flash-next
# FALLBACK_MODEL=deepseek-v4.1-flash
# Models users may pick on the "Under the hood" page
ALLOWED_MODELS=qwen3.8-flash-next,deepseek-v4.1-flash,glm-5.3-flash,kimi-k3
# Optional price overrides, USD per million tokens
# MODEL_PRICES={"qwen3.8-flash-next":{"in":0.1,"cached":0.01,"out":0.4}}

# ---- Memory (Hindsight) ------------------------------------------------------------------------
HINDSIGHT_URL=http://hindsight:8888
# Shared with the hindsight service; only the app can use the memory API
HINDSIGHT_API_KEY=change-me-memory-key
MEMORY_ENABLED=true

# ---- Product -----------------------------------------------------------------------------------
ASSISTANT_NAME=Tarka
PRODUCT_NAME=Tarka Assistant
# open | invite | closed
SIGNUP_MODE=invite
TRIAL_DAYS=14
PRICE_LABEL=$20/month
PROACTIVE_ENABLED=true
MAX_PROACTIVE_PER_DAY=4

# ---- Telegram (one shared bot) ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes back on every webhook call
# Optional: derived from APP_SECRET when empty
TELEGRAM_WEBHOOK_SECRET=
# webhook | polling | off  (defaults: webhook in production, polling in development)
# TELEGRAM_MODE=webhook

# ---- Telnyx: SMS, WhatsApp and phone calls ----------------------------------------------------
TELNYX_API_KEY=
# Public key from Mission Control > Keys & Credentials > Public Key (base64)
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PHONE_NUMBER=
TELNYX_WHATSAPP_NUMBER=
# Approved utility template for WhatsApp messages outside the 24-hour window
TELNYX_WHATSAPP_TEMPLATE=
# Meta allows general-purpose AI assistants on WhatsApp in the EEA only (2026)
# WHATSAPP_ALLOWED_COUNTRIES=AT,BE,...
# Telnyx AI Assistants that use this app as their custom LLM (see docs/channels.md)
TELNYX_VOICE_ASSISTANT_ID=
TELNYX_CONCIERGE_ASSISTANT_ID=
# Secret Telnyx sends as the custom LLM's API key (store it as a Telnyx integration secret)
VOICE_LLM_SECRET=

# ---- Google (Gmail, Calendar, Drive, Contacts) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Web search (pick one) ----------------------------------------------------------------------
# SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=

# ---- Email sign-in links (Brevo) ----------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM=Tarka Assistant <assistant@tarkahq.com>

# ---- Billing (Stripe) ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- Tarka sandboxes (exact calculations) --------------------------------------------------------
# A tk_live_ key with the "sandboxes" scope is needed; TARKA_API_KEY is reused.
TARKA_ORG_ID=
SANDBOX_TEMPLATE=python-3.13
