{
  "name": "@tarka/assistant",
  "version": "0.1.0",
  "description": "Instinct-style personal assistant that runs on Tarka",
  "main": "dist/main.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chat": "tsx src/cli.ts",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "license": "MIT",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "@vectorize-io/hindsight-client": "^1.0.0",
    "ai": "^7.0.142",
    "chrono-node": "^2.10.3",
    "cron-parser": "^5.10.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "luxon": "^3.7.2",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
